# Copy this file to .env and fill in your values.
# For OpenAI:
OPENAI_API_KEY=sk-your-key-here

# Optional: point to any OpenAI-compatible endpoint.
# e.g. local Ollama: http://localhost:11434/v1
# e.g. LM Studio:   http://localhost:1234/v1
OPENAI_BASE_URL=

# Model to use (defaults to gpt-4o-mini)
OPENAI_MODEL=
